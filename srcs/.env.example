# Copy this file to srcs/.env and replace every CHANGE_ME.
# Passwords never go here: they live in secrets/ (see secrets.example/).

LOGIN=CHANGE_ME
DOMAIN_NAME=CHANGE_ME.42.fr

# MariaDB (names only; passwords are in secrets/)
MYSQL_DATABASE=wordpress
MYSQL_USER=CHANGE_ME

# WordPress (the administrator name must not contain "admin")
WP_TITLE=Inception
WP_ADMIN_USER=CHANGE_ME
WP_ADMIN_EMAIL=CHANGE_ME@example.com
WP_USER=CHANGE_ME
WP_USER_EMAIL=CHANGE_ME@example.com
